$bog_wiki_app $mol_page
	title \WikiLive: живые таблицы
	nav_options *
		home \Главная
		editor \Редактор
	Navbar $mol_switch
		value? <=> screen? \home
		options <= nav_options
	tools /
		<= Sources $mol_link_source
			uri \https://github.com/bog/wiki
		<= Status $giper_baza_status
		<= Theme_toggle $bog_theme_toggle
			theme_auto <= Theme
	head /
		<= Title
		<= Navbar
		<= Tools
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	body <= screen_body /
	pages *
		home <= Home $mol_page
			Head null
			body /
				<= Welcome $mol_text
					text \
						\# WikiLive: живые таблицы
						\
						\Начать создавать по шаблонам
		editor <= Editor_page $bog_wiki_editor
