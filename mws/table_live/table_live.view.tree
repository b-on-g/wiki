$bog_wiki_mws_table_live $mol_view
	dst_id \
	view_id? \
	view_mode? \grid
	sub /
		<= Toolbar $mol_view
			sub /
				<= Toolbar_label $mol_paragraph
					title <= toolbar_title \MWS Table
				<= View_switch $mol_switch
					value? <=> view_id? \
					options <= view_options *
				<= Mode_switch $mol_switch
					value? <=> view_mode? \grid
					options *
						grid \Table
						gallery \Cards
				<= Refresh $mol_button_minor
					title \↻
					click?event <=> refresh?event null
				<= Add_row $mol_button_minor
					title \+ Row
					click?event <=> add_row?event null
				<= Delete_selected $mol_button_minor
					title \🗑 Delete
					click?event <=> delete_selected?event null
		<= Content $mol_view
			sub <= content_body /
	Table $bog_ui_table
		columns <= columns /
		data <= data /
		selectable true
		selected? <=> selected? /
		cell_value*? <=> cell_value*? \
	Gallery $mol_list
		rows <= gallery_rows /
	Card* $mol_view
		sub <= card_fields* /
	Card_field* $mol_view
		sub /
			<= card_field_label* \
			<= card_field_value* \
