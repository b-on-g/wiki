$bog_wiki_editor $bog_wysiwyg_app
	Wiki_theme $bog_theme_auto
		theme_light \$mol_theme_calm_light
		theme_dark \$mol_theme_calm_dark
		themes /
			\$mol_theme_calm_light
			\$mol_theme_calm_dark
	plugins /
		<= Wiki_theme
		<= Status $giper_baza_status
	tools /
		<= Registry_toggle
		<= History_toggle
		<= Graph_toggle
		<= Permissions_toggle
		<= Profile_toggle
		<= Sources $mol_link_source
			uri \https://github.com/bog/wiki
		<= Theme_toggle $bog_theme_toggle
			theme_auto <= Wiki_theme
	main_content /
		<= Editor
		<= Space $bog_wiki_mws_space
